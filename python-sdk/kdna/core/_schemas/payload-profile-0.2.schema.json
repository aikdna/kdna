          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "profile",
        "profile_version",
        "asset",
        "actors",
        "scope",
        "judgments"
      ],
      "type": "object"
    },
    "PredicateOperator": {
      "enum": [
        "equals",
        "not_equals",
        "greater_than",
        "less_than",
        "contains",
        "is_present"

      "type": "object"
    },
    "MaterialKind": {
      "enum": [
        "definition",
        "foundation",
        "premise",
        "example",
        "attachment"
      ],
      "type": "string"
    },
    "MethodBinding": {
      "additionalProperties": false,
      "properties": {
        "component_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "role": {
          "$ref": "#/$defs/Identifier"
        },
        "target_ref": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "component_ref",
        "role",
        "target_ref"
      ],
      "type": "object"
    },
    "MethodComponent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "method": {
          "$ref": "#/$defs/TermRef"

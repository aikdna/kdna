      "required": [
        "role",
        "actor_ids",
        "statement"
      ],
      "type": "object"
    },
    "AttributionDeclaration": {
      "oneOf": [
        {
          "$ref": "#/$defs/AttributionProvided"
        },
        {
          "$ref": "#/$defs/AttributionUnprovided"
        }
      ]
    },
    "AttributionProvided": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "provided",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Attribution"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "AttributionRole": {
      "enum": [
        "creator",
        "rights_holder",
        "representative"
      ],
      "type": "string"
    },
    "AttributionUnprovided": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/AuthoredUnprovidedState"
        },
        "value": {
          "const": null,
          "type": "null"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "AuthoredDeclarations": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "boundaries": {
          "$ref": "#/$defs/BoundaryDeclaration"
        },
        "highest_question": {
          "$ref": "#/$defs/TextDeclaration"
        },
        "role": {
          "$ref": "#/$defs/RoleDeclaration"
        },
        "value_order": {
          "$ref": "#/$defs/TextListDeclaration"
        },
        "worldview": {
          "$ref": "#/$defs/TextListDeclaration"
        }
      },
      "required": [],
      "type": "object"
    },
    "AuthoredUnprovidedState": {
      "enum": [
        "unknown",
        "none",
        "not_applicable"
      ],
      "type": "string"
    },
    "Boolean": {
      "type": "boolean"
    },
    "Boundary": {
      "additionalProperties": false,
      "properties": {
        "declared_by": {
          "$ref": "#/$defs/Identifier"
        },
        "effect": {
          "$ref": "#/$defs/BoundaryEffect"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "statement": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": [
        "id",
        "effect",
        "statement",
        "declared_by"
      ],
      "type": "object"
    },
    "BoundaryDeclaration": {
      "oneOf": [
        {
          "$ref": "#/$defs/BoundaryDeclarationProvided"
        },
        {
          "$ref": "#/$defs/BoundaryDeclarationUnprovided"
        }
      ]
    },
    "BoundaryDeclarationProvided": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "provided",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Boundary"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "BoundaryDeclarationUnprovided": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/AuthoredUnprovidedState"
        },
        "value": {
          "const": null,
          "type": "null"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "BoundaryEffect": {
      "enum": [
        "exclude",
        "limit",
        "out_of_domain"
      ],
      "type": "string"
    },
    "Cohesion": {
      "additionalProperties": false,
      "properties": {
        "governance": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "projection_closure": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "purpose": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "rights_compatibility": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "subject_relationship": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": [
        "purpose",
        "governance",
        "subject_relationship",
        "projection_closure",
        "rights_compatibility"
      ],
      "type": "object"
    },
    "Condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/InterpretedCondition"
        },
        {
          "$ref": "#/$defs/StructuredCondition"
        },
        {
          "$ref": "#/$defs/EvaluatorCondition"
        }
      ]
    },
    "ConditionOperand": {
      "oneOf": [
        {
          "$ref": "#/$defs/DependencyOperand"
        },
        {
          "$ref": "#/$defs/LiteralOperand"
        }
      ]
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "consumer_judgment_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "data_type": {
          "$ref": "#/$defs/TermRef"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "input_role": {
          "$ref": "#/$defs/Identifier"
        },
        "producer": {
          "oneOf": [
            {
              "$ref": "#/$defs/JudgmentProducer"
            },
            {
              "$ref": "#/$defs/SourceProducer"
            }
          ]
        },
        "purpose": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "required": {
          "$ref": "#/$defs/Boolean"
        }
      },
      "required": [
        "id",
        "producer",
        "consumer_judgment_ref",
        "input_role",
        "data_type",
        "required",
        "purpose"
      ],
      "type": "object"
    },
    "DependencyOperand": {
      "additionalProperties": false,
      "properties": {
        "dependency_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "const": "dependency",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dependency_ref"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntryName": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\\\u0000-\\u001f\\u007f-\\u009f]+$",
      "type": "string"
    },
    "EvaluatorCondition": {
      "additionalProperties": false,
      "properties": {
        "declaration": {
          "$ref": "#/$defs/StructuredCondition"
        },
        "evaluator": {
          "$ref": "#/$defs/TermRef"
        },
        "kind": {
          "const": "external_evaluator",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "declaration",
        "evaluator"
      ],
      "type": "object"
    },
    "Exception": {
      "additionalProperties": false,
      "properties": {
        "boundary_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "statement": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": [
        "id",
        "statement",
        "boundary_ref"
      ],
      "type": "object"
    },
    "ExceptionDeclaration": {
      "oneOf": [
        {
          "$ref": "#/$defs/ExceptionDeclarationProvided"
        },
        {
          "$ref": "#/$defs/ExceptionDeclarationUnprovided"
        }
      ]
    },
    "ExceptionDeclarationProvided": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "provided",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Exception"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "ExceptionDeclarationUnprovided": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/AuthoredUnprovidedState"
        },
        "value": {
          "const": null,
          "type": "null"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "critical": {
          "$ref": "#/$defs/Boolean"
        },
        "definition": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "value": {
          "$ref": "#/$defs/SemanticValue"
        }
      },
      "required": [
        "id",
        "critical",
        "definition",
        "value"
      ],
      "type": "object"
    },
    "FiniteNumber": {
      "type": "number"
    },
    "FormationRule": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "minItems": 0,
          "type": "array"

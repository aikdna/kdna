        "statement": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": [
        "kind",
        "statement"
      ],
      "type": "object"
    },
    "Judgment": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "result"
          ]
        },
        {
          "required": [
            "formation_rule"
          ]
        }
      ],
      "properties": {
        "boundaries": {
          "$ref": "#/$defs/BoundaryDeclaration"
        },
        "exceptions": {
          "$ref": "#/$defs/ExceptionDeclaration"
        },
        "extensions": {
          "items": {
            "$ref": "#/$defs/Extension"
          },
          "minItems": 0,
          "type": "array"

          "minItems": 0,
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/MethodComponent"
          },
          "minItems": 0,
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/TermRef"
        }
      },
      "required": [
        "method",
        "components",
        "bindings"
      ],
      "type": "object"
    },
    "Misuse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "statement": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "type": "object"
    },
    "MisuseDeclaration": {
      "oneOf": [
        {
          "$ref": "#/$defs/MisuseDeclarationProvided"
        },
        {
          "$ref": "#/$defs/MisuseDeclarationUnprovided"
        }
      ]
    },
    "MisuseDeclarationProvided": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "provided",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Misuse"

        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "material_refs": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "method": {
          "$ref": "#/$defs/MethodUse"
        },
        "misuse": {
          "$ref": "#/$defs/MisuseDeclaration"
        },
        "mode": {
          "$ref": "#/$defs/TermRef"
        },
        "nature": {
          "$ref": "#/$defs/TermRef"
        },
        "reason_refs": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "result": {
          "$ref": "#/$defs/Result"
        },
        "result_contract": {
          "$ref": "#/$defs/ResultContract"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        }
      },
      "required": [
        "id",
        "focus",
        "subject",
        "scope",
        "result_contract"
      ],
      "type": "object"
    },
    "JudgmentProducer": {
      "additionalProperties": false,
      "properties": {
        "judgment_ref": {
          "$ref": "#/$defs/Identifier"

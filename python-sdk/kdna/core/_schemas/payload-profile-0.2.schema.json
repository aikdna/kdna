{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "name": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "person",
        "organization",
        "collective",
        "anonymous",
        "asset_native",
        "agent"
      ],
      "type": "string"
    },
    "AssetIdentity": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "judgment_version": {
          "$ref": "#/$defs/VersionLabel"
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "judgment_version"
      ],
      "type": "object"
    },
    "Attribution": {
      "additionalProperties": false,
      "properties": {
        "actor_ids": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "role": {
          "$ref": "#/$defs/AttributionRole"
        },
        "statement": {
          "$ref": "#/$defs/Text"
        }

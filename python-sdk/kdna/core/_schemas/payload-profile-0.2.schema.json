        "value": {
          "const": null,
          "type": "null"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "type": "object"
    },
    "NonEmptyText": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "Payload": {
      "additionalProperties": false,
      "properties": {
        "actors": {
          "items": {
            "$ref": "#/$defs/Actor"
          },
          "minItems": 0,
          "type": "array"
        },
        "asset": {
          "$ref": "#/$defs/AssetIdentity"
        },
        "attributions": {
          "$ref": "#/$defs/AttributionDeclaration"
        },
        "cohesion": {
          "$ref": "#/$defs/Cohesion"
        },
        "content_risk": {
          "$ref": "#/$defs/RiskState"
        },
        "declarations": {
          "$ref": "#/$defs/AuthoredDeclarations"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "minItems": 0,
          "type": "array"
        },
        "extensions": {
          "items": {
            "$ref": "#/$defs/Extension"
          },
          "minItems": 0,
          "type": "array"
        },
        "judgments": {
          "items": {
            "$ref": "#/$defs/Judgment"
          },
          "minItems": 1,
          "type": "array"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/Material"
          },
          "minItems": 0,
          "type": "array"
        },
        "profile": {
          "const": "kdna.payload.judgment",
          "type": "string"
        },
        "profile_version": {
          "const": "0.2.0",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "minItems": 0,
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "minItems": 0,
          "type": "array"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "minItems": 0,
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_uses": {
          "items": {
            "$ref": "#/$defs/SourceUse"
          },
          "minItems": 0,
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"

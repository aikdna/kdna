        "role",
        "judgment_ref",
        "statement",
        "component_refs"
      ],
      "type": "object"
    },
    "ReasonRole": {
      "enum": [
        "support",
        "counter",
        "qualification",
        "calibration"
      ],
      "type": "string"
    },
    "RecordShape": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/ShapeField"

        "statement": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": [
        "statement",
        "conditions",
        "output_contract_ref"
      ],
      "type": "object"
    },
    "Identifier": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "InterpretedCondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "interpreted",
          "type": "string"

    {
      "change": "删authored.order或duplicates",
      "expected": "定义不完整，拒绝，不猜默认"
    },
    {
      "change": "order=priority但两条priority相同或缺失",
      "expected": "拒绝不确定顺序"
    },
    {
      "change": "merge输入端口改指普通ResultContract",
      "expected": "类型不符，拒绝，不把原生Emission当SemanticValue"
    },
    {
      "change": "输入包成ValueList或ValueRecord或JSON文本",
      "expected": "专用输入值结构不符，拒绝，不自动解包"
    },
    {
      "change": "最终结果或候选改指EmissionListContract",
      "expected": "用途错误，拒绝"
    },
    {
      "change": "通过普通link或literal给专用端口再供一次值",
      "expected": "违反唯一供给，拒绝"
    },
    {
      "change": "cond1未知",
      "expected": "defer，merge不取得部分输入"
    },
    {
      "change": "全部条件false",

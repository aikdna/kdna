{
  "$defs": {
    "AssetCapability": {
      "enum": [
        "asserted_answers",
        "result_forming_rules",
        "mixed"
      ],
      "type": "string"
    },
    "CoreAdmissionRejected": {
      "additionalProperties": false,
      "properties": {
        "component_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoreComponentFailure"
            },
            {
              "const": null,
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/ReadDiagnostic"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/ReadDiagnosticCode"
        },
        "states": {
          "$ref": "#/$defs/CoreStaticStates"
        },
        "status": {
          "const": "rejected",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "diagnostics",
        "states",
        "component_failure"
      ],
      "type": "object"
    },
    "CoreComponentFailure": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "const": null,
          "type": "null"
        },
        "code": {
          "enum": [
            "READ_COMPONENT_DECLARATION_INVALID",
            "READ_COMPONENT_CONTENT_INVALID",
            "READ_COMPONENT_REFERENCE_INVALID",
            "READ_COMPONENT_GRAPH_CYCLE",
            "READ_COMPONENT_LIMIT_EXCEEDED",
            "READ_COMPONENT_BINDING_INVALID",
            "READ_COMPONENT_ADOPTION_INVALID",
            "READ_METHOD_PRESENCE_INVALID"
          ],
          "type": "string"
        },
        "component_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "const": null,
              "type": "null"
            }
          ]
        },
        "judgment_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "const": null,
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "invalid",
          "type": "string"
        }
      },
      "required": [
        "judgment_ref",
        "component_ref",
        "status",
        "body",
        "code"
      ],
      "type": "object"
    },
    "CoreStaticStates": {
      "additionalProperties": false,
      "properties": {
        "core": {
          "$ref": "#/$defs/TechnicalState"
        },
        "interpretation": {
          "$ref": "#/$defs/InterpretationState"
        }
      },
      "required": [
        "core",
        "interpretation"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "InterpretationState": {
      "enum": [
        "not_evaluated",
        "complete",
        "degraded",
        "blocked"

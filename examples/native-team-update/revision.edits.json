    "judgments": [
      {
        "id": "update:order",
        "focus": "Weekly update order",
        "subject": {
          "actor_ids": [
            "actor:synthetic-task-agent"
          ],
          "statement": "The Agent-authored ordering preference for this synthetic weekly team-update task, adapted from the public teaching sample."
        },
        "scope": {
          "statement": "Routine weekly asynchronous team updates, including a time-sensitive teammate decision that gates the next action. This Agent-authored adaptation is a synthetic task preference; urgent incident response and a universal communication rule are outside its scope."
        },
        "answer_kind": "preference",
        "parent_ref": null,
        "form": "conclusion",
        "core_expression": {
          "kind": "authored",
          "statement": "For a routine weekly asynchronous team update, keep completed changes first, then current blockers, then the next concrete action. If a teammate must make a time-sensitive decision before the next action can proceed, put that decision request and its deadline first, then completed changes with evidence, then the next action conditional on the decision. Keep a pending decision visibly pending.",
          "qualification_refs": []
        },
        "method": {
          "method": {
            "term": "feedback"
          },
          "components": [
            {
              "id": "component:update:order:target",
              "method": {
                "term": "feedback"
              },
              "role": "调整目标",
              "material_refs": [],
              "statement": "Make the pending teammate decision visible in time for action while preserving evidence for completed work and the routine completed-first default."
            },
            {
              "id": "component:update:order:signal",
              "method": {
                "term": "feedback"
              },
              "role": "反馈信号",
              "material_refs": [],
              "statement": "The first draft placed shipped work before the migration decision. Synthetic task feedback says the teammate decision is urgent and should lead; that decision is due Thursday and gates the next action. No real teammate or original sample author supplied or confirmed this feedback."
            },
            {
              "id": "component:update:order",
              "method": {
                "term": "feedback"
              },
              "role": "调整办法",
              "material_refs": [],
              "statement": "Apply the decision-first exception only when a time-sensitive teammate decision gates the next action; otherwise keep completed changes, blockers, next action. Retain evidence links and their limits, keep the decision pending until answered, and state both possible next actions."
            }
          ],
          "bindings": []
        },

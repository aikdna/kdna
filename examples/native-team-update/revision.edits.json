        "scope": {
          "statement": "The example author’s preferences for routine weekly asynchronous updates in their team; urgent incident response is outside this scope."
        },
        "answer_kind": "preference",
        "parent_ref": null,
        "form": "conclusion",
        "core_expression": {
          "kind": "authored",
          "statement": "When I describe a completed change, I prefer a link to an observable result and a brief statement of what it proves; when evidence is unavailable, I say so.",

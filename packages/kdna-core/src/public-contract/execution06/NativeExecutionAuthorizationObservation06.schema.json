{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:execution06:NativeExecutionAuthorizationObservation06",
  "title": "NativeExecutionAuthorizationObservation06",
  "description": "Candidate native execution data only; native admitted brands and independent action authorization are required.",
  "$ref": "#/$defs/NativeExecutionAuthorizationObservation06",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "NativeExecutionAuthorizationObservation06": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ]
        },
        "authorization_id": {
          "$ref": "#/$defs/Identifier"
        },
        "host_id": {
          "$ref": "#/$defs/Identifier"
        },
        "host_epoch": {
          "$ref": "#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "issued_at": {
          "$ref": "#/$defs/UInt"
        },
        "expires_at": {
          "$ref": "#/$defs/UInt"
        }
      },
      "required": [
        "decision",
        "authorization_id",
        "host_id",
        "host_epoch",
        "request_digest",
        "issued_at",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "UInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}

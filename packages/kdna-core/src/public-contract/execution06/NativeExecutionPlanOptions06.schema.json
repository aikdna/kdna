{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:execution06:NativeExecutionPlanOptions06",
  "title": "NativeExecutionPlanOptions06",
  "description": "Candidate native execution data only; native admitted brands and independent action authorization are required.",
  "$ref": "#/$defs/NativeExecutionPlanOptions06",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "NativeExecutionPlanOptions06": {
      "type": "object",
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "intent": {
          "$ref": "#/$defs/PublicExecutionIntent"
        },
        "selection": {
          "$ref": "#/$defs/SelectionSet06"
        },
        "budget": {
          "$ref": "#/$defs/PublicExecutionBudget"
        }
      },
      "required": [
        "plan_id",
        "intent",
        "selection",
        "budget"
      ],
      "additionalProperties": false
    },
    "NonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "PublicExecutionBudget": {
      "type": "object",
      "properties": {
        "capsule_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "output_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "trace_events": {
          "$ref": "#/$defs/UInt"
        },
        "response_bytes": {
          "$ref": "#/$defs/UInt"
        }
      },
      "required": [
        "capsule_bytes",
        "output_bytes",
        "trace_events",
        "response_bytes"
      ],
      "additionalProperties": false
    },
    "PublicExecutionIntent": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "use": {
          "const": "reasoning_support",
          "type": "string"
        }
      },
      "required": [
        "task",
        "use"
      ],
      "additionalProperties": false
    },
    "SelectionSet06": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "judgment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "judgment_ids"
      ],
      "additionalProperties": false
    },
    "UInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "VersionLabel": {
      "$ref": "#/$defs/Identifier"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:packageset06:NativePackageSetAdmissionResult06",
  "title": "NativePackageSetAdmissionResult06",
  "description": "Native PackageSet structural data only; member, byte, retained Read and action authorities remain independent actual brands.",
  "$ref": "#/$defs/NativePackageSetAdmissionResult06",
  "$defs": {
    "AdmittedNativePackageSet06": false,
    "CapturedInput06": {
      "type": "object",
      "properties": {
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        },
        "input_byte_length": {
          "$ref": "#/$defs/UInt"
        },
        "manifest_bytes_digest": {
          "$ref": "#/$defs/Digest"
        },
        "zip_directory_bytes_digest": {
          "$ref": "#/$defs/Digest"
        },
        "table_frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckedSection06"
          },
          "minItems": 0
        },
        "identity_scope": {
          "type": "string",
          "const": "observed_metadata_and_loaded_sections_only"
        }
      },
      "required": [
        "capture_id",
        "input_byte_length",
        "manifest_bytes_digest",
        "zip_directory_bytes_digest",
        "table_frames",
        "identity_scope"
      ],
      "additionalProperties": false
    },
    "CheckedSection06": {
      "type": "object",
      "properties": {
        "section_id": {
          "$ref": "#/$defs/Identifier"
        },
        "member": {
          "$ref": "#/$defs/EntryName"
        },
        "offset_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "length_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "section_id",
        "member",
        "offset_bytes",
        "length_bytes",
        "digest"
      ],
      "additionalProperties": false
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EntryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "NativePackageSetAdmissionResult06": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "admitted"
            },
            "admission": {
              "$ref": "#/$defs/AdmittedNativePackageSet06"
            },
            "decision": {
              "$ref": "#/$defs/NativePackageSetDecisionAllowed06"
            },
            "local_failure": {
              "type": "null",
              "const": null
            },
            "member_failure": {
              "type": "null",
              "const": null
            }
          },
          "required": [
            "status",
            "admission",
            "decision",
            "local_failure",
            "member_failure"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "admission": {
              "type": "null",
              "const": null
            },
            "decision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NativePackageSetDecisionRejected06"
                },
                {
                  "type": "null",
                  "const": null
                }
              ]
            },
            "local_failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NativePackageSetLocalFailure06"
                },
                {
                  "type": "null",
                  "const": null
                }
              ]
            },
            "member_failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NativePackageSetMemberFailure06"
                },
                {
                  "type": "null",
                  "const": null
                }
              ]
            }
          },
          "required": [
            "status",
            "admission",
            "decision",
            "local_failure",
            "member_failure"
          ],
          "additionalProperties": false
        }
      ]
    },
    "NativePackageSetDecisionAllowed06": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "allowed"
        },
        "selected_member": {
          "$ref": "#/$defs/Identifier"
        },
        "merged_ir": {
          "type": "boolean",
          "const": false
        },
        "action_authorized": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "status",
        "selected_member",
        "merged_ir",
        "action_authorized"
      ],
      "additionalProperties": false
    },
    "NativePackageSetDecisionRejected06": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "rejected"
        },
        "diagnostic": {
          "type": "string",
          "enum": [
            "READ_INPUT_INVALID",
            "SET_MEMBER_UNAUTHORIZED",
            "SET_MEMBER_MISSING",
            "SET_MEMBER_EXTRA",
            "SET_MEMBER_DUPLICATE",
            "READ_UNSUPPORTED_VERSION",
            "READ_MIXED_VERSION_TUPLE",
            "READ_CORE_INVALID",
            "UNSUPPORTED_CROSS_ASSET_SEMANTIC_MERGE",
            "READ_SELECTION_AMBIGUOUS",
            "READ_SELECTION_NOT_FOUND"
          ]
        },
        "merged_ir": {
          "type": "boolean",
          "const": false
        },
        "action_authorized": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "status",
        "diagnostic",
        "merged_ir",
        "action_authorized"
      ],
      "additionalProperties": false
    },
    "NativePackageSetLocalFailure06": {
      "type": "string",
      "enum": [
        "invalid_limits",
        "member_limit_exceeded",
        "source_bytes_limit_exceeded",
        "invalid_member_source",
        "invalid_read_request",
        "provider_invalid",
        "provider_failed",
        "provider_observation_invalid",
        "cancelled",
        "core_unavailable",
        "delivery_unconfirmed",
        "handoff_invalid",
        "member_admission_failed",
        "read_preparation_failed"
      ]
    },
    "NativePackageSetMemberFailure06": {
      "type": "object",
      "properties": {
        "member_id": {
          "$ref": "#/$defs/Identifier"
        },
        "result": {
          "$ref": "#/$defs/NativeSectionByteRejected06"
        }
      },
      "required": [
        "member_id",
        "result"
      ],
      "additionalProperties": false
    },
    "NativeSectionByteContract06": {
      "type": "object",
      "properties": {
        "id": {
          "const": "kdna.section-bytes-node",
          "type": "string"
        },
        "version": {
          "const": "0.1.1-candidate",
          "type": "string"
        },
        "definition_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "version",
        "definition_digest"
      ],
      "additionalProperties": false
    },
    "NativeSectionByteObservation06": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/NativeSectionByteContract06"
        },
        "input_kind": {
          "type": "string",
          "const": "owned_uint8array"
        },
        "input_byte_length": {
          "$ref": "#/$defs/UInt"
        },
        "ownership_copy": {
          "type": "object",
          "properties": {
            "offset_bytes": {
              "type": "integer",
              "const": 0
            },
            "length_bytes": {
              "$ref": "#/$defs/UInt"
            }
          },
          "required": [
            "offset_bytes",
            "length_bytes"
          ],
          "additionalProperties": false
        },
        "capture": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapturedInput06"
            },
            {
              "type": "null"
            }
          ]
        },
        "access_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionIORange06"
          }
        },
        "filesystem_reads": {
          "type": "integer",
          "const": 0
        }
      },
      "required": [
        "contract",
        "input_kind",
        "input_byte_length",
        "ownership_copy",
        "capture",
        "access_ranges",
        "filesystem_reads"
      ],
      "additionalProperties": false
    },
    "NativeSectionByteRejected06": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/NativeSectionByteContract06"
        },
        "status": {
          "type": "string",
          "enum": [
            "rejected",
            "unsupported"
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "input",
            "metadata",
            "authorization",
            "content",
            "semantic",
            "integrity"
          ]
        },
        "reason": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/SectionFailureDiagnostic06"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeSectionByteObservation06"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "type": "null"
        }
      },
      "required": [
        "contract",
        "status",
        "request_id",
        "stage",
        "reason",
        "diagnostic",
        "input_observation",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "NonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "SectionFailureDiagnostic06": {
      "type": "object",
      "properties": {
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field",
        "subject"
      ],
      "additionalProperties": false
    },
    "SectionIORange06": {
      "oneOf": [
        {
          "$ref": "#/$defs/SectionIOSingleRange06"
        },
        {
          "$ref": "#/$defs/SectionIOStructureBatch06"
        }
      ]
    },
    "SectionIOSingleRange06": {
      "type": "object",
      "properties": {
        "offset_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "length_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "zip_end",
            "zip_directory",
            "zip_local_header",
            "zip_local_name",
            "mimetype",
            "manifest",
            "whole_after_authorization",
            "zip_directory_header",
            "zip_directory_name",
            "section_table_after_authorization",
            "section_content_after_authorization",
            "resource_after_authorization",
            "section_structure_after_authorization",
            "zip_locator_local_signature",
            "zip_locator_local_header",
            "zip_locator_directory_signature",
            "zip_locator_directory_header",
            "zip_locator_directory_name",
            "zip_locator_local_name",
            "zip_locator_eocd",
            "zip_comment",
            "checksum_document_after_authorization",
            "checksum_member_after_authorization",
            "signature_document_after_authorization",
            "signature_member_after_authorization"
          ]
        }
      },
      "required": [
        "offset_bytes",
        "length_bytes",
        "purpose"
      ],
      "additionalProperties": false
    },
    "SectionIOStructureBatch06": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "section_structure_after_authorization",
            "section_interpretation_after_authorization"
          ]
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "offset_bytes": {
                "$ref": "#/$defs/UInt"
              },
              "length_bytes": {
                "$ref": "#/$defs/UInt"
              }
            },
            "required": [
              "offset_bytes",
              "length_bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "purpose",
        "ranges"
      ],
      "additionalProperties": false
    },
    "Text": {
      "type": "string"
    },
    "UInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}

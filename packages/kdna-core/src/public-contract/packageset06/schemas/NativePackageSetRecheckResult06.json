{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:packageset06:NativePackageSetRecheckResult06",
  "title": "NativePackageSetRecheckResult06",
  "description": "Native PackageSet structural data only; member, byte, retained Read and action authorities remain independent actual brands.",
  "$ref": "#/$defs/NativePackageSetRecheckResult06",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "NativePackageSetDecisionAllowed06": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "allowed"
        },
        "selected_member": {
          "$ref": "#/$defs/Identifier"
        },
        "merged_ir": {
          "type": "boolean",
          "const": false
        },
        "action_authorized": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "status",
        "selected_member",
        "merged_ir",
        "action_authorized"
      ],
      "additionalProperties": false
    },
    "NativePackageSetDecisionRejected06": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "rejected"
        },
        "diagnostic": {
          "type": "string",
          "enum": [
            "READ_INPUT_INVALID",
            "SET_MEMBER_UNAUTHORIZED",
            "SET_MEMBER_MISSING",
            "SET_MEMBER_EXTRA",
            "SET_MEMBER_DUPLICATE",
            "READ_UNSUPPORTED_VERSION",
            "READ_MIXED_VERSION_TUPLE",
            "READ_CORE_INVALID",
            "UNSUPPORTED_CROSS_ASSET_SEMANTIC_MERGE",
            "READ_SELECTION_AMBIGUOUS",
            "READ_SELECTION_NOT_FOUND"
          ]
        },
        "merged_ir": {
          "type": "boolean",
          "const": false
        },
        "action_authorized": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "status",
        "diagnostic",
        "merged_ir",
        "action_authorized"
      ],
      "additionalProperties": false
    },
    "NativePackageSetLocalFailure06": {
      "type": "string",
      "enum": [
        "invalid_limits",
        "member_limit_exceeded",
        "source_bytes_limit_exceeded",
        "invalid_member_source",
        "invalid_read_request",
        "provider_invalid",
        "provider_failed",
        "provider_observation_invalid",
        "cancelled",
        "core_unavailable",
        "delivery_unconfirmed",
        "handoff_invalid",
        "member_admission_failed",
        "read_preparation_failed"
      ]
    },
    "NativePackageSetRecheckResult06": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "allowed"
            },
            "decision": {
              "$ref": "#/$defs/NativePackageSetDecisionAllowed06"
            },
            "local_failure": {
              "type": "null",
              "const": null
            }
          },
          "required": [
            "status",
            "decision",
            "local_failure"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            },
            "decision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NativePackageSetDecisionRejected06"
                },
                {
                  "type": "null",
                  "const": null
                }
              ]
            },
            "local_failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NativePackageSetLocalFailure06"
                },
                {
                  "type": "null",
                  "const": null
                }
              ]
            }
          },
          "required": [
            "status",
            "decision",
            "local_failure"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

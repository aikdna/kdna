{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:packageset06:NativePackageSetDecisionAllowed06",
  "title": "NativePackageSetDecisionAllowed06",
  "description": "Native PackageSet structural data only; member, byte, retained Read and action authorities remain independent actual brands.",
  "$ref": "#/$defs/NativePackageSetDecisionAllowed06",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "NativePackageSetDecisionAllowed06": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "allowed"
        },
        "selected_member": {
          "$ref": "#/$defs/Identifier"
        },
        "merged_ir": {
          "type": "boolean",
          "const": false
        },
        "action_authorized": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "status",
        "selected_member",
        "merged_ir",
        "action_authorized"
      ],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:retained06:RetainedSectionPreparationResult06",
  "title": "RetainedSectionPreparationResult06",
  "description": "Candidate retained structural data only; native origins/preparations require same-instance brand.",
  "$ref": "#/$defs/RetainedSectionPreparationResult06",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "PreparedRetainedSectionRead06": false,
    "ReadDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ReadDiagnosticCode"
        },
        "stage": {
          "$ref": "#/$defs/ReadStage"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "stage",
        "severity",
        "subject",
        "field"
      ],
      "additionalProperties": false
    },
    "ReadDiagnosticCode": {
      "type": "string",
      "enum": [
        "READ_INPUT_INVALID",
        "READ_SNAPSHOT_UNATTESTED",
        "READ_CORE_CAPABILITY_UNAVAILABLE",
        "READ_UNSUPPORTED_VERSION",
        "READ_MIXED_VERSION_TUPLE",
        "READ_CORE_INVALID",
        "READ_INTERPRETATION_INCOMPLETE",
        "READ_STATIC_POLICY_INVALID",
        "READ_ASSET_MISMATCH",
        "READ_ASSET_VERSION_MISMATCH",
        "READ_SELECTION_NOT_FOUND",
        "READ_SELECTION_AMBIGUOUS",
        "READ_HANDLE_UNTRUSTED",
        "READ_HANDLE_VERSION_MISMATCH",
        "READ_HANDLE_STALE",
        "READ_HANDLE_ASSET_MISMATCH",
        "READ_HANDLE_SCOPE_MISMATCH",
        "READ_HOST_CONTEXT_UNTRUSTED",
        "READ_HOST_EPOCH_MISMATCH",
        "READ_HOST_TIME_INVALID",
        "READ_HANDLE_EXPIRED",
        "READ_HOST_CONTEXT_EXPIRED",
        "READ_HOST_DENIED",
        "READ_SCOPE_DENIED",
        "READ_PROJECTION_INVALID",
        "READ_BUDGET_INSUFFICIENT",
        "READ_COMPONENT_DECLARATION_INVALID",
        "READ_COMPONENT_CONTENT_INVALID",
        "READ_COMPONENT_REFERENCE_INVALID",
        "READ_COMPONENT_GRAPH_CYCLE",
        "READ_COMPONENT_LIMIT_EXCEEDED",
        "READ_COMPONENT_BINDING_INVALID",
        "READ_COMPONENT_ADOPTION_INVALID",
        "READ_METHOD_PRESENCE_INVALID",
        "READ_R2_STRUCTURE_INVALID",
        "READ_R2_REFERENCE_INVALID",
        "READ_R2_METHOD_INVALID",
        "READ_R2_PLAN_INVALID",
        "READ_R2_POLICY_INVALID",
        "READ_R2_SCOPE_INVALID",
        "READ_R2_EXAMPLE_INVALID",
        "READ_R2_HISTORY_INVALID",
        "READ_UNSUPPORTED_CRITICAL",
        "READ_UNRESOLVED_EXTERNAL"
      ]
    },
    "ReadStage": {
      "type": "string",
      "enum": [
        "input",
        "version",
        "core",
        "selection",
        "handle",
        "host",
        "projection",
        "budget"
      ]
    },
    "RetainedSectionContract06": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "kdna.retained-sections"
        },
        "version": {
          "type": "string",
          "const": "0.1.0-candidate"
        },
        "definition_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "version",
        "definition_digest"
      ],
      "additionalProperties": false
    },
    "RetainedSectionDetail06": {
      "type": "string",
      "enum": [
        "input_invalid",
        "version_unsupported",
        "mixed_tuple",
        "origin_untrusted",
        "origin_protected",
        "origin_scope_insufficient",
        "authority_untrusted",
        "authority_denied",
        "signature_policy_unsatisfied",
        "handle_invalid",
        "host_invalid",
        "budget_insufficient",
        "internal_capability_unavailable"
      ]
    },
    "RetainedSectionFailure06": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/RetainedSectionContract06"
        },
        "status": {
          "type": "string",
          "const": "rejected"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null",
              "const": null
            }
          ]
        },
        "diagnostic": {
          "$ref": "#/$defs/ReadDiagnostic"
        },
        "detail": {
          "$ref": "#/$defs/RetainedSectionDetail06"
        },
        "body": {
          "type": "null",
          "const": null
        },
        "body_bytes": {
          "type": "integer",
          "const": 0
        }
      },
      "required": [
        "contract",
        "status",
        "request_id",
        "diagnostic",
        "detail",
        "body",
        "body_bytes"
      ],
      "additionalProperties": false
    },
    "RetainedSectionPreparationResult06": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "prepared"
            },
            "prepared": {
              "$ref": "#/$defs/PreparedRetainedSectionRead06"
            }
          },
          "required": [
            "status",
            "prepared"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/RetainedSectionFailure06"
        }
      ]
    },
    "Text": {
      "type": "string"
    }
  }
}

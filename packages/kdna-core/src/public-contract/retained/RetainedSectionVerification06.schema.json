            },
            "observed_entry_set_digest": {
              "$ref": "#/$defs/Digest"
            },
            "covered_entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EntryName"
              },
              "minItems": 2,
              "maxItems": 128,
              "uniqueItems": true
            },
            "capture_id": {
              "$ref": "#/$defs/Identifier"
            },
            "request_digest": {
              "$ref": "#/$defs/Digest"
            },
            "observed_A": {
              "$ref": "#/$defs/Digest"
            },
            "observed_C": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "status",
            "profile",
            "profile_version",
            "document_digest",
            "expected_entry_set_digest",
            "observed_entry_set_digest",
            "covered_entries",
            "capture_id",
            "request_digest",
            "observed_A",
            "observed_C"
          ],
          "additionalProperties": false
        }
      ]

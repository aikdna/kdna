      "type": "object",
      "properties": {
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        },
        "input_byte_length": {
          "$ref": "#/$defs/UInt"
        },
        "manifest_bytes_digest": {
          "$ref": "#/$defs/Digest"
        },
        "zip_directory_bytes_digest": {
          "$ref": "#/$defs/Digest"
        },
        "table_frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckedSection06"
          },
          "minItems": 0
        },
        "identity_scope": {
          "type": "string",
          "const": "observed_metadata_and_loaded_sections_only"
        }
      },
      "required": [
        "capture_id",
        "input_byte_length",
        "manifest_bytes_digest",
        "zip_directory_bytes_digest",
        "table_frames",
        "identity_scope"
      ],
      "additionalProperties": false
    },
    "CatalogVerification06": {
      "type": "object",
      "properties": {
        "capture": {
          "$ref": "#/$defs/CapturedInput06"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "checked_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckedSection06"
          },
          "minItems": 0
        },
        "unchecked_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "routing_integrity": {
          "type": "string",
          "const": "checked"
        },
        "runtime_entry_digest": {
          "$ref": "#/$defs/ScopedRuntimeEntryDigest06"
        },
        "whole_container_digest": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "kdna.digest-basis.container-bytes/0.2.0"
            },
            "status": {
              "type": "string",
              "const": "not_checked"
            },
            "claimed_digest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Digest"
                },
                {
                  "type": "null",
                  "const": null
                }
              ]
            }
          },
          "required": [
            "profile",
            "status",
            "claimed_digest"
          ],
          "additionalProperties": false
        },
        "whole_content_digest": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "kdna.digest-basis.content-tree/0.2.0"
            },
            "status": {
              "type": "string",
              "const": "not_checked"
            },
            "claimed_digest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Digest"
                },
                {
                  "type": "null",
                  "const": null
                }
              ]
            }
          },
          "required": [
            "profile",
            "status",
            "claimed_digest"
          ],
          "additionalProperties": false
        },
        "ir_digest": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "CanonicalIR:SHA-256(RFC8785):existing-digestCanonical"
            },
            "status": {
              "type": "string",
              "const": "not_checked"
            },
            "claimed_digest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Digest"
                },
                {
                  "type": "null",
                  "const": null
                }
              ]
            }
          },
          "required": [
            "profile",
            "status",
            "claimed_digest"
          ],
          "additionalProperties": false
        },
        "mode": {
          "type": "string",
          "const": "catalog"
        },
        "semantic_status": {
          "type": "string",
          "const": "metadata_only"
        },
        "checksum_integrity": {
          "$ref": "#/$defs/ScopedChecksumVerification06"
        },
        "signature_integrity": {
          "$ref": "#/$defs/SectionSignatureVerification06"
        }
      },
      "required": [
        "capture",
        "request_digest",
        "checked_sections",
        "unchecked_sections",
        "routing_integrity",
        "runtime_entry_digest",
        "whole_container_digest",
        "whole_content_digest",
        "ir_digest",
        "mode",
        "semantic_status",
        "checksum_integrity",
        "signature_integrity"
      ],
      "additionalProperties": false
    },
    "CheckedSection06": {
      "type": "object",
      "properties": {
        "section_id": {
          "$ref": "#/$defs/Identifier"
        },
        "member": {
          "$ref": "#/$defs/EntryName"
        },
        "offset_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "length_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "section_id",
        "member",
        "offset_bytes",
        "length_bytes",
        "digest"
      ],
      "additionalProperties": false
    },
    "ChecksumsEntry06": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/EntryName"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "name",
        "bytes",
        "digest"
      ],
      "additionalProperties": false
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EntryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[/]$)[^\\\\\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "ObservedRuntimeEntryDigest06": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "verified"
        },
        "profile": {
          "type": "string",
          "const": "kdna.digest-basis.runtime-entry-set/0.3.0-candidate"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "member_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntryName"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "profile",
        "digest",
        "member_names"
      ],
      "additionalProperties": false
    },
    "RetainedSectionContract06": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "kdna.retained-sections"
        },
        "version": {
          "type": "string",
          "const": "0.1.0-candidate"
        },
        "definition_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "version",
        "definition_digest"
      ],
      "additionalProperties": false
    },
    "RetainedSectionOrigin06": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "whole",
            "catalog"
          ]
        },
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        },
        "admission_request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "verification_digest": {
          "$ref": "#/$defs/Digest"
        },
        "checked_sections_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "snapshot_id",
        "kind",
        "capture_id",
        "admission_request_digest",
        "verification_digest",
        "checked_sections_digest"
      ],
      "additionalProperties": false
    },
    "RetainedSectionSignaturePolicyCheck06": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "const": "immutable_origin_signature_receipt"
        },
        "policy": {
          "$ref": "#/$defs/SectionSignaturePolicy06"
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "origin_receipt_digest": {
          "$ref": "#/$defs/Digest"
        },
        "result": {
          "type": "string",
          "const": "satisfied"
        },
        "new_signature_verification": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "basis",
        "policy",
        "policy_digest",
        "origin_receipt_digest",
        "result",
        "new_signature_verification"
      ],
      "additionalProperties": false
    },
    "RetainedSectionVerification06": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/RetainedSectionContract06"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "origin": {
          "$ref": "#/$defs/RetainedSectionOrigin06"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "intent_digest": {
          "$ref": "#/$defs/Digest"
        },
        "mode": {
          "type": "string",
          "enum": [
            "whole_asset",
            "catalog",
            "exact_selection",
            "expand"
          ]
        },
        "origin_verification": {
          "oneOf": [
            {
              "$ref": "#/$defs/WholeVerification06"
            },
            {
              "$ref": "#/$defs/CatalogVerification06"
            }
          ]
        },
        "signature_policy_check": {
          "$ref": "#/$defs/RetainedSectionSignaturePolicyCheck06"
        },
        "new_capture": {
          "type": "boolean",
          "const": false
        },
        "io": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionIOSingleRange06"
          },
          "minItems": 0,
          "maxItems": 0
        },
        "new_domain_validation": {
          "type": "boolean",
          "const": false
        },
        "new_digest_computation": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "contract",
        "operation_id",
        "origin",
        "request_digest",
        "intent_digest",
        "mode",
        "origin_verification",
        "signature_policy_check",
        "new_capture",
        "io",
        "new_domain_validation",
        "new_digest_computation"
      ],
      "additionalProperties": false
    },
    "ScopedChecksumMemberObservation06": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/EntryName"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "expected_digest": {
          "$ref": "#/$defs/Digest"
        },
        "observed_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "name",
        "bytes",
        "expected_digest",
        "observed_digest"
      ],
      "additionalProperties": false
    },
    "ScopedChecksumVerification06": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "absent"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "checked_members_document_2"
            },
            "profile": {
              "type": "string",
              "const": "kdna.checksums.document/2"
            },
            "profile_version": {
              "type": "string",
              "const": "2.0.0-candidate"
            },
            "declaration_status": {
              "type": "string",
              "const": "shape_and_directory_checked"
            },
            "document_digest": {
              "$ref": "#/$defs/Digest"

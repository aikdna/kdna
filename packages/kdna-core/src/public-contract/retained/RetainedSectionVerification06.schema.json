            "covered_entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EntryName"
              },
              "minItems": 2,
              "maxItems": 128,
              "uniqueItems": true
            },
            "checked_entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ScopedChecksumMemberObservation06"

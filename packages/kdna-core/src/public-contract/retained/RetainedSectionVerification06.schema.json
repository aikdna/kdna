    "SectionSignatureVerification06": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "absent"
            },
            "read_intent_digest": {
              "$ref": "#/$defs/Digest"
            },
            "policy": {
              "$ref": "#/$defs/SectionSignaturePolicy06"
            },
            "policy_digest": {
              "$ref": "#/$defs/Digest"
            },
            "capture_id": {
              "$ref": "#/$defs/Identifier"
            },
            "request_digest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "status",
            "read_intent_digest",
            "policy",
            "policy_digest",
            "capture_id",
            "request_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "verified_self_key",
                "verified_pinned_key"
              ]
            },
            "read_intent_digest": {
              "$ref": "#/$defs/Digest"
            },
            "policy": {
              "$ref": "#/$defs/SectionSignaturePolicy06"
            },
            "policy_digest": {
              "$ref": "#/$defs/Digest"
            },
            "capture_id": {
              "$ref": "#/$defs/Identifier"
            },
            "request_digest": {
              "$ref": "#/$defs/Digest"
            },
            "profile": {
              "type": "string",
              "const": "kdsig.ed25519"
            },
            "profile_version": {
              "type": "string",
              "const": "0.1.0"
            },
            "algorithm": {
              "type": "string",
              "const": "ed25519"
            },
            "signature_document_digest": {
              "$ref": "#/$defs/Digest"
            },
            "expected_signature_content_digest": {
              "$ref": "#/$defs/Digest"
            },
            "observed_signature_content_digest": {
              "$ref": "#/$defs/Digest"
            },
            "public_key": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "key_fingerprint": {
              "$ref": "#/$defs/Digest"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SectionSignatureMember06"
              },
              "minItems": 2,
              "maxItems": 128
            },
            "excluded_members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EntryName"
              },
              "minItems": 0,
              "maxItems": 128
            }
          },
          "required": [
            "status",
            "read_intent_digest",
            "policy",
            "policy_digest",
            "capture_id",
            "request_digest",
            "profile",
            "profile_version",
            "algorithm",
            "signature_document_digest",
            "expected_signature_content_digest",
            "observed_signature_content_digest",
            "public_key",
            "key_fingerprint",
            "members",
            "excluded_members"
          ],
          "additionalProperties": false
        }
      ]
    },
    "UInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991

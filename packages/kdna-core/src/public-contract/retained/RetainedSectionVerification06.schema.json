{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:retained06:RetainedSectionVerification06",
  "title": "RetainedSectionVerification06",
  "description": "Candidate retained structural data only; native origins/preparations require same-instance brand.",

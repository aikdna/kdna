                    "expected_digest": {
                      "$ref": "#/$defs/Digest"
                    },
                    "observed_digest": {
                      "type": "null",
                      "const": null
                    },
                    "comparison": {
                      "type": "string",
                      "const": "not_compared"
                    },
                    "reason": {
                      "type": "string",
                      "const": "members_unchecked"
                    }
                  },
                  "required": [
                    "status",
                    "expected_digest",
                    "observed_digest",
                    "comparison",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "verified"
                    },
                    "expected_digest": {
                      "$ref": "#/$defs/Digest"
                    },
                    "observed_digest": {
                      "$ref": "#/$defs/Digest"
                    },
                    "comparison": {
                      "type": "string",
                      "const": "matched"
                    },
                    "basis": {
                      "type": "string",
                      "const": "actual_complete_member_bytes"
                    }
                  },
                  "required": [
                    "status",
                    "expected_digest",
                    "observed_digest",
                    "comparison",
                    "basis"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "capture_id": {
              "$ref": "#/$defs/Identifier"
            },
            "request_digest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "status",
            "profile",
            "profile_version",
            "declaration_status",
            "document_digest",
            "covered_entries",
            "checked_entries",
            "unchecked_entries",
            "entry_set_digest",
            "capture_id",
            "request_digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ScopedRuntimeEntryDigest06": {
      "oneOf": [
        {
          "$ref": "#/$defs/UnobservedRuntimeEntryDigest06"

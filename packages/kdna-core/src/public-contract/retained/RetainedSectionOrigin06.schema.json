{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:retained06:RetainedSectionOrigin06",
  "title": "RetainedSectionOrigin06",
  "description": "Candidate retained structural data only; native origins/preparations require same-instance brand.",
  "$ref": "#/$defs/RetainedSectionOrigin06",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "RetainedSectionOrigin06": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "whole",
            "catalog"
          ]
        },
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        },
        "admission_request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "verification_digest": {
          "$ref": "#/$defs/Digest"
        },
        "checked_sections_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "snapshot_id",
        "kind",
        "capture_id",
        "admission_request_digest",
        "verification_digest",
        "checked_sections_digest"
      ],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:retained06:RetainedSectionContract06",
  "title": "RetainedSectionContract06",
  "description": "Candidate retained structural data only; native origins/preparations require same-instance brand.",
  "$ref": "#/$defs/RetainedSectionContract06",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "RetainedSectionContract06": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "kdna.retained-sections"
        },
        "version": {
          "type": "string",
          "const": "0.1.0-candidate"
        },
        "definition_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "version",
        "definition_digest"
      ],
      "additionalProperties": false
    }
  }
}

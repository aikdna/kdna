{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:retained06:RetainedSectionHostObservation06",
  "title": "RetainedSectionHostObservation06",
  "description": "Candidate retained structural data only; native origins/preparations require same-instance brand.",
  "$ref": "#/$defs/RetainedSectionHostObservation06",
  "$defs": {
    "AssetIdentity": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "judgment_version": {
          "$ref": "#/$defs/VersionLabel"
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "judgment_version"
      ],
      "additionalProperties": false
    },
    "CandidateVersionTuple06": {
      "type": "object",
      "properties": {
        "container": {
          "const": "0.6.0",
          "type": "string"
        },
        "payload_profile": {
          "const": "kdna.payload.judgment",
          "type": "string"
        },
        "payload_version": {
          "const": "0.5.1",
          "type": "string"
        },
        "core": {
          "const": "kdna.core/0.8.2",
          "type": "string"
        },
        "ir": {
          "const": "kdna.canonical-ir/0.6.1",
          "type": "string"
        },
        "runtime": {
          "const": "kdna.runtime-capsule/0.3.1",
          "type": "string"
        },
        "plan": {
          "const": "kdna.consumption-plan/0.3.1",
          "type": "string"
        },
        "host": {
          "const": "kdna.agent-host/0.3.1",
          "type": "string"
        },
        "trace": {
          "const": "kdna.judgment-trace/0.3.1",
          "type": "string"
        },
        "read": {
          "const": "kdna.read/0.7.0-candidate",
          "type": "string"
        }
      },
      "required": [
        "container",
        "payload_profile",
        "payload_version",
        "core",
        "ir",
        "runtime",
        "plan",
        "host",
        "trace",
        "read"
      ],
      "additionalProperties": false
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "RetainedSectionHostObservation06": {
      "type": "object",
      "properties": {
        "host_id": {
          "$ref": "#/$defs/Identifier"
        },
        "host_epoch": {
          "$ref": "#/$defs/Identifier"
        },
        "decision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "origin": {
          "$ref": "#/$defs/RetainedSectionOrigin06"
        },
        "intent_digest": {
          "$ref": "#/$defs/Digest"
        },
        "asset": {
          "$ref": "#/$defs/AssetIdentity"
        },
        "tuple": {
          "$ref": "#/$defs/CandidateVersionTuple06"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "issued_at": {
          "$ref": "#/$defs/UInt"
        },
        "expires_at": {
          "$ref": "#/$defs/UInt"
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ]
        },
        "policy_id": {
          "$ref": "#/$defs/Identifier"
        },
        "current_ms": {
          "$ref": "#/$defs/UInt"
        },
        "revoked": {
          "type": "boolean"
        },
        "lift_denial": {
          "type": "boolean"
        }
      },
      "required": [
        "host_id",
        "host_epoch",
        "decision_id",
        "operation_id",
        "request_id",
        "request_digest",
        "origin",
        "intent_digest",
        "asset",
        "tuple",
        "scope",
        "issued_at",
        "expires_at",
        "decision",
        "policy_id",
        "current_ms"
      ],
      "additionalProperties": false
    },
    "RetainedSectionOrigin06": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "whole",
            "catalog"
          ]
        },
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        },
        "admission_request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "verification_digest": {
          "$ref": "#/$defs/Digest"
        },
        "checked_sections_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "snapshot_id",
        "kind",
        "capture_id",
        "admission_request_digest",
        "verification_digest",
        "checked_sections_digest"
      ],
      "additionalProperties": false
    },
    "UInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "VersionLabel": {
      "$ref": "#/$defs/Identifier"
    }
  }
}

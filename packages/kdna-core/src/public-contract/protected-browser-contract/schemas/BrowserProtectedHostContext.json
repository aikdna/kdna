{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:protected-browser:BrowserProtectedHostContext",
  "title": "BrowserProtectedHostContext",
  "description": "Browser protected retained projection contract. Original base tuple and host-supplied-triple provenance; no native authentication claims.",
  "$ref": "#/$defs/BrowserProtectedHostContext",
  "$defs": {
    "AssetIdentity": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "judgment_version": {
          "$ref": "#/$defs/VersionLabel"
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "judgment_version"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedBinding": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "source_request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "read_intent_digest": {
          "$ref": "#/$defs/Digest"
        },
        "tuple": {
          "$ref": "#/$defs/VersionTuple"
        },
        "asset": {
          "$ref": "#/$defs/AssetIdentity"
        },
        "A": {
          "$ref": "#/$defs/Digest"
        },
        "C": {
          "$ref": "#/$defs/Digest"
        },
        "E": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "operation_id",
        "snapshot_id",
        "capture_id",
        "request_id",
        "request_digest",
        "source_request_digest",
        "read_intent_digest",
        "tuple",
        "asset",
        "A",
        "C",
        "E"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedExpansionHandle": {
      "oneOf": [
        {
          "$ref": "#/$defs/BrowserProtectedWholeHandle"
        },
        {
          "$ref": "#/$defs/BrowserProtectedSetHandle"
        }
      ]
    },
    "BrowserProtectedHostContext": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/BrowserProtectedRequest"
        },
        "binding": {
          "$ref": "#/$defs/BrowserProtectedBinding"
        },
        "projection_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "issued_handle_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrowserProtectedExpansionHandle"
          }
        },
        "protection_receipt": {
          "$ref": "#/$defs/BrowserProtectedReceipt"
        }
      },
      "required": [
        "request",
        "binding",
        "projection_scope",
        "issued_handle_scopes",
        "protection_receipt"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedReceipt": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "const": "kdna.protected-browser-observation/0.1.0-candidate"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "A": {
          "$ref": "#/$defs/Digest"
        },
        "C": {
          "$ref": "#/$defs/Digest"
        },
        "E": {
          "$ref": "#/$defs/Digest"
        },
        "checked_at_ms": {
          "$ref": "#/$defs/UInt"
        },
        "proof": {
          "type": "string",
          "const": "observation_not_authority"
        },
        "provenance": {
          "type": "string",
          "const": "host_supplied_triple"
        }
      },
      "required": [
        "contract",
        "operation_id",
        "snapshot_id",
        "A",
        "C",
        "E",
        "checked_at_ms",
        "proof",
        "provenance"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedRequest": {
      "oneOf": [
        {
          "$ref": "#/$defs/BrowserProtectedRequest_whole_asset"
        },
        {
          "$ref": "#/$defs/BrowserProtectedRequest_catalog"
        },
        {
          "$ref": "#/$defs/BrowserProtectedRequest_exact_selection"
        },
        {
          "$ref": "#/$defs/BrowserProtectedRequest_expand"
        }
      ]
    },
    "BrowserProtectedRequest_catalog": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "tuple": {
          "$ref": "#/$defs/VersionTuple"
        },
        "budget_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "mode": {
          "const": "catalog",
          "type": "string"
        },
        "selection": {
          "const": null,
          "type": "null"
        },
        "handle": {
          "type": "null",
          "const": null
        }
      },
      "required": [
        "request_id",
        "tuple",
        "budget_bytes",
        "mode",
        "selection",
        "handle"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedRequest_exact_selection": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "tuple": {
          "$ref": "#/$defs/VersionTuple"
        },
        "budget_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "mode": {
          "const": "exact_selection",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/BrowserProtectedSelection"
        },
        "handle": {
          "type": "null",
          "const": null
        }
      },
      "required": [
        "request_id",
        "tuple",
        "budget_bytes",
        "mode",
        "selection",
        "handle"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedRequest_expand": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "tuple": {
          "$ref": "#/$defs/VersionTuple"
        },
        "budget_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "mode": {
          "type": "string",
          "const": "expand"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserProtectedSelection"
            },
            {
              "type": "null",
              "const": null
            }
          ]
        },
        "handle": {
          "$ref": "#/$defs/BrowserProtectedExpansionHandle"
        }
      },
      "required": [
        "request_id",
        "tuple",
        "budget_bytes",
        "mode",
        "selection",
        "handle"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedRequest_whole_asset": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "tuple": {
          "$ref": "#/$defs/VersionTuple"
        },
        "budget_bytes": {
          "$ref": "#/$defs/UInt"
        },
        "mode": {
          "const": "whole_asset",
          "type": "string"
        },
        "selection": {
          "const": null,
          "type": "null"
        },
        "handle": {
          "type": "null",
          "const": null
        }
      },
      "required": [
        "request_id",
        "tuple",
        "budget_bytes",
        "mode",
        "selection",
        "handle"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedSelection": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "judgment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "judgment_ids"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedSetHandle": {
      "type": "object",
      "properties": {
        "handle_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "A": {
          "$ref": "#/$defs/Digest"
        },
        "C": {
          "$ref": "#/$defs/Digest"
        },
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "core_version": {
          "$ref": "#/$defs/Identifier"
        },
        "ir_version": {
          "$ref": "#/$defs/Identifier"
        },
        "read_version": {
          "$ref": "#/$defs/Identifier"
        },
        "target": {
          "$ref": "#/$defs/Ref"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issued_at": {
          "$ref": "#/$defs/UInt"
        },
        "expires_at": {
          "$ref": "#/$defs/UInt"
        },
        "host_id": {
          "$ref": "#/$defs/Identifier"
        },
        "host_epoch": {
          "$ref": "#/$defs/Identifier"
        },
        "anchor": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "selection_set"
            },
            "selection": {
              "$ref": "#/$defs/BrowserProtectedSelection"
            }
          },
          "required": [
            "kind",
            "selection"
          ],
          "additionalProperties": false
        },
        "binding_kind": {
          "type": "string",
          "const": "protected_selection_set"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "handle_id",
        "asset_id",
        "asset_version",
        "A",
        "C",
        "snapshot_id",
        "core_version",
        "ir_version",
        "read_version",
        "anchor",
        "target",
        "scope",
        "issued_at",
        "expires_at",
        "host_id",
        "host_epoch",
        "binding_kind",
        "operation_id",
        "capture_id"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedWholeHandle": {
      "type": "object",
      "properties": {
        "handle_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "A": {
          "$ref": "#/$defs/Digest"
        },
        "C": {
          "$ref": "#/$defs/Digest"
        },
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "core_version": {
          "$ref": "#/$defs/Identifier"
        },
        "ir_version": {
          "$ref": "#/$defs/Identifier"
        },
        "read_version": {
          "$ref": "#/$defs/Identifier"
        },
        "target": {
          "$ref": "#/$defs/Ref"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issued_at": {
          "$ref": "#/$defs/UInt"
        },
        "expires_at": {
          "$ref": "#/$defs/UInt"
        },
        "host_id": {
          "$ref": "#/$defs/Identifier"
        },
        "host_epoch": {
          "$ref": "#/$defs/Identifier"
        },
        "anchor": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "asset"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "handle_id",
        "asset_id",
        "asset_version",
        "A",
        "C",
        "snapshot_id",
        "core_version",
        "ir_version",
        "read_version",
        "anchor",
        "target",
        "scope",
        "issued_at",
        "expires_at",
        "host_id",
        "host_epoch"
      ],
      "additionalProperties": false
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "Ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "asset",
            "judgment",
            "result",
            "contract",
            "condition",
            "component",
            "unit",
            "plan",
            "plan_node",
            "policy",
            "branch_entry",
            "candidate",
            "material",
            "shared_declaration",
            "boundary",
            "exception",
            "misuse",
            "reason",
            "source",
            "source_use",
            "resource",
            "relationship",
            "dependency",
            "example",
            "example_result",
            "revision",
            "actor"
          ]
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset": {
          "$ref": "#/$defs/AssetIdentity"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "UInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "VersionLabel": {
      "$ref": "#/$defs/Identifier"
    },
    "VersionTuple": {
      "type": "object",
      "properties": {
        "container": {
          "const": "0.5.0",
          "type": "string"
        },
        "payload_profile": {
          "const": "kdna.payload.judgment",
          "type": "string"
        },
        "payload_version": {
          "const": "0.5.1",
          "type": "string"
        },
        "core": {
          "const": "kdna.core/0.8.2",
          "type": "string"
        },
        "ir": {
          "const": "kdna.canonical-ir/0.6.1",
          "type": "string"
        },
        "runtime": {
          "const": "kdna.runtime-capsule/0.3.1",
          "type": "string"
        },
        "plan": {
          "const": "kdna.consumption-plan/0.3.1",
          "type": "string"
        },
        "host": {
          "const": "kdna.agent-host/0.3.1",
          "type": "string"
        },
        "trace": {
          "const": "kdna.judgment-trace/0.3.1",
          "type": "string"
        },
        "read": {
          "const": "kdna.read/0.6.4",
          "type": "string"
        }
      },
      "required": [
        "container",
        "payload_profile",
        "payload_version",
        "core",
        "ir",
        "runtime",
        "plan",
        "host",
        "trace",
        "read"
      ],
      "additionalProperties": false
    }
  }
}

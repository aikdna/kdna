{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kdna:candidate:protected-browser:BrowserProtectedExpansionHandle",
  "title": "BrowserProtectedExpansionHandle",
  "description": "Browser protected retained projection contract. Original base tuple and host-supplied-triple provenance; no native authentication claims.",
  "$ref": "#/$defs/BrowserProtectedExpansionHandle",
  "$defs": {
    "AssetIdentity": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "judgment_version": {
          "$ref": "#/$defs/VersionLabel"
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "judgment_version"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedExpansionHandle": {
      "oneOf": [
        {
          "$ref": "#/$defs/BrowserProtectedWholeHandle"
        },
        {
          "$ref": "#/$defs/BrowserProtectedSetHandle"
        }
      ]
    },
    "BrowserProtectedSelection": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "judgment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1
        }
      },
      "required": [
        "asset_id",
        "asset_version",
        "judgment_ids"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedSetHandle": {
      "type": "object",
      "properties": {
        "handle_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "A": {
          "$ref": "#/$defs/Digest"
        },
        "C": {
          "$ref": "#/$defs/Digest"
        },
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "core_version": {
          "$ref": "#/$defs/Identifier"
        },
        "ir_version": {
          "$ref": "#/$defs/Identifier"
        },
        "read_version": {
          "$ref": "#/$defs/Identifier"
        },
        "target": {
          "$ref": "#/$defs/Ref"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issued_at": {
          "$ref": "#/$defs/UInt"
        },
        "expires_at": {
          "$ref": "#/$defs/UInt"
        },
        "host_id": {
          "$ref": "#/$defs/Identifier"
        },
        "host_epoch": {
          "$ref": "#/$defs/Identifier"
        },
        "anchor": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "selection_set"
            },
            "selection": {
              "$ref": "#/$defs/BrowserProtectedSelection"
            }
          },
          "required": [
            "kind",
            "selection"
          ],
          "additionalProperties": false
        },
        "binding_kind": {
          "type": "string",
          "const": "protected_selection_set"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "handle_id",
        "asset_id",
        "asset_version",
        "A",
        "C",
        "snapshot_id",
        "core_version",
        "ir_version",
        "read_version",
        "anchor",
        "target",
        "scope",
        "issued_at",
        "expires_at",
        "host_id",
        "host_epoch",
        "binding_kind",
        "operation_id",
        "capture_id"
      ],
      "additionalProperties": false
    },
    "BrowserProtectedWholeHandle": {
      "type": "object",
      "properties": {
        "handle_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset_version": {
          "$ref": "#/$defs/VersionLabel"
        },
        "A": {
          "$ref": "#/$defs/Digest"
        },
        "C": {
          "$ref": "#/$defs/Digest"
        },
        "snapshot_id": {
          "$ref": "#/$defs/Identifier"
        },
        "core_version": {
          "$ref": "#/$defs/Identifier"
        },
        "ir_version": {
          "$ref": "#/$defs/Identifier"
        },
        "read_version": {
          "$ref": "#/$defs/Identifier"
        },
        "target": {
          "$ref": "#/$defs/Ref"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issued_at": {
          "$ref": "#/$defs/UInt"
        },
        "expires_at": {
          "$ref": "#/$defs/UInt"
        },
        "host_id": {
          "$ref": "#/$defs/Identifier"
        },
        "host_epoch": {
          "$ref": "#/$defs/Identifier"
        },
        "anchor": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "asset"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "handle_id",
        "asset_id",
        "asset_version",
        "A",
        "C",
        "snapshot_id",
        "core_version",
        "ir_version",
        "read_version",
        "anchor",
        "target",
        "scope",
        "issued_at",
        "expires_at",
        "host_id",
        "host_epoch"
      ],
      "additionalProperties": false
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "Ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "asset",
            "judgment",
            "result",
            "contract",
            "condition",
            "component",
            "unit",
            "plan",
            "plan_node",
            "policy",
            "branch_entry",
            "candidate",
            "material",
            "shared_declaration",
            "boundary",
            "exception",
            "misuse",
            "reason",
            "source",
            "source_use",
            "resource",
            "relationship",
            "dependency",
            "example",
            "example_result",
            "revision",
            "actor"
          ]
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "asset": {
          "$ref": "#/$defs/AssetIdentity"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "UInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "VersionLabel": {
      "$ref": "#/$defs/Identifier"
    }
  }
}
